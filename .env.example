# Robinhood Agentic Trading Environment Configuration
# Copy this file to .env and replace with your account details if desired.
# If ROBINHOOD_ACCOUNT_NUMBER is omitted, the agent will automatically resolve your agentic account via get_accounts.

ROBINHOOD_ACCOUNT_NUMBER=your_robinhood_account_number

# Robinhood Crypto API Credentials (Optional - for live 24/7 crypto trading execution)
# Generated from Robinhood Crypto Account API Settings (API Key & Base64 Ed25519 Private Key)
ROBINHOOD_CRYPTO_API_KEY=your_crypto_api_key
ROBINHOOD_CRYPTO_PRIVATE_KEY=your_base64_ed25519_private_key

